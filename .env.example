# RepoReady server configuration. Copy to `.env` (repo root) and fill in.
# Required values have no default; the server refuses to start without them.

# Runtime mode: development | production | test
NODE_ENV=development

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Port the API listens on.
PORT=4000

# MongoDB connection string (local or Atlas free tier). Required.
MONGODB_URI=mongodb://127.0.0.1:27017/repoready

# GitHub personal access token. Needs no scopes (public data only); raises the API rate limit
# from 60 to 5,000 requests/hour. Server-side only, never sent to the client or logged. Required.
GITHUB_TOKEN=

# Origin allowed by CORS (the client's URL).
CLIENT_ORIGIN=http://localhost:5173

# Reject repositories larger than this (GitHub reports size in KB).
MAX_REPO_SIZE_KB=100000

# Hard cap for one whole analysis, in milliseconds.
ANALYSIS_TIMEOUT_MS=90000

# Heap cap (MB) for the architecture worker thread. Use 256 on a 512 MB host.
ARCHITECTURE_MAX_MEMORY_MB=512

# Reuse a finished analysis for this many hours if the commit SHA has not changed.
CACHE_TTL_HOURS=24

# --- Private repository mode (docs/ADDENDUM_01_PRIVATE_REPOS.md) ---
# Users may analyze private repos with their own read-only fine-grained token, sent in the
# X-GitHub-Token header. The token is never stored; reports live in server memory only.
# Set to false to hide the feature and reject tokens.
PRIVATE_MODE_ENABLED=true

# Minutes a private report is kept in memory before it is deleted.
PRIVATE_REPORT_TTL_MINUTES=60

# Maximum private reports held at once; the oldest is evicted when full.
MAX_PRIVATE_REPORTS=50

# --- Rate limits (per client IP) ---
# New analyses per hour (public and private, including failed attempts).
RATE_LIMIT_CREATES_PER_HOUR=10

# API reads per minute (badges are not limited).
RATE_LIMIT_READS_PER_MINUTE=120
